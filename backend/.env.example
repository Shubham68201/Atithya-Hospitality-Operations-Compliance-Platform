# ══════════════════════════════════════════════════════
#  ATITHYA BACKEND — Environment Variables
#  Copy to .env and fill all values marked REQUIRED
# ══════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────
NODE_ENV=development          # production on Render
PORT=5000                     # Render uses 10000

# ── MongoDB ──────────────────────────────────────── REQUIRED
MONGO_URI=mongodb://localhost:27017/atithya_db
# Production Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/atithya_db

# ── JWT ──────────────────────────────────────────── REQUIRED
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHAR_STRING_HERE
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ── CORS ─────────────────────────────────────────── REQUIRED in production
CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL_2=                 # Optional second allowed origin

# ── Gmail SMTP ───────────────────────────────────── REQUIRED for emails
# IMPORTANT: Use an App Password, NOT your regular Gmail password
# Get it: myaccount.google.com → Security → 2FA → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=abcdefghijklmnop    # 16-char App Password (no spaces)
FROM_NAME=Atithya Platform
FROM_EMAIL=your_gmail@gmail.com

# ── Cloudinary ───────────────────────────────────── REQUIRED for file uploads
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── OTP ──────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
